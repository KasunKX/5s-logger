{
  "name": "sitesight",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n frontend,api -c cyan,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace @sitesight/frontend",
    "dev:backend": "python -m flask --app app run --debug --port 5000",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --workspace @sitesight/frontend",
    "lint": "npm run lint --workspace @sitesight/frontend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace @sitesight/frontend",
    "test:backend": "python -m unittest discover -s app/tests"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
